# systemd unit that runs the household MCP server (for AI agents) as a
# background service on a Linux machine without Docker, next to the web app
# in household-app.service. See "As a systemd service" in the README.
#
# YOUR_USER and /home/YOUR_USER/household-app are placeholders: the README's
# install command fills them in with your user and the repo's folder.
#
# Settings (MCP_PORT, MCP_API_KEY) come from the .env file in the repo
# folder, which the server loads itself at startup.

[Unit]
Description=Household app (MCP server for AI agents)
# Start after the web app, which creates the database tables on first run.
After=network.target household-app.service

[Service]
Type=simple
# Runs as the user who owns the repo folder in /home.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/household-app
ExecStart=/home/YOUR_USER/household-app/.venv/bin/python -m app.mcp_server

# Serve MCP over HTTP (SSE) on MCP_PORT instead of stdio, like Docker does.
Environment=MCP_TRANSPORT=sse
# Send print() output to the journal right away instead of buffering it.
Environment=PYTHONUNBUFFERED=1

# Restart after a crash (not after `systemctl stop`), waiting 5 s between tries.
Restart=on-failure
RestartSec=5

# Basic hardening: no privilege escalation, read-only /usr, /boot and /etc,
# and a private /tmp. (No ProtectHome: the app itself lives in /home.)
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
