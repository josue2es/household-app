# systemd unit that runs the household web app as a background service on
# a Linux machine without Docker. See "As a systemd service" in the
# README for the full install steps.
#
# YOUR_USER and /home/YOUR_USER/household-app are placeholders: the README's
# install command fills them in with your user and the repo's folder.
#
# Settings (APP_PORT, STORAGE_SECRET, GEMINI_API_KEY, ...) come from the
# .env file in the repo folder, which the app loads itself at startup.

[Unit]
Description=Household app (NiceGUI web app)
After=network.target

[Service]
Type=simple
# Runs as the user who owns the repo folder in /home.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/household-app
ExecStart=/home/YOUR_USER/household-app/.venv/bin/python -m app.main

# Send print() output to the journal right away instead of buffering it.
Environment=PYTHONUNBUFFERED=1

# Restart after a crash (not after `systemctl stop`), waiting 5 s between tries.
Restart=on-failure
RestartSec=5

# Basic hardening: no privilege escalation, read-only /usr, /boot and /etc,
# and a private /tmp. (No ProtectHome: the app itself lives in /home.)
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
