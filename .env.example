# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Secret used to sign NiceGUI browser sessions.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
STORAGE_SECRET=change-me

# Bearer token that MCP clients must send to connect to the MCP server.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to run it unauthenticated; it then only accepts requests
# addressed to localhost, so remote clients can't connect.
MCP_API_KEY=change-me

# Google Gemini API key used to identify grocery items from photos.
# Get one at https://aistudio.google.com/ → "Get API key".
GEMINI_API_KEY=change-me

# Optional: override the vision model (default: gemini-3-pro-preview).
#GEMINI_MODEL=gemini-3-pro-preview

# Optional: address and port for the web app when running without Docker
# (defaults: 0.0.0.0 and 8080). Use APP_HOST=127.0.0.1 behind a reverse proxy
# like Caddy, so the app is only reachable through it. Docker ignores these.
#APP_HOST=0.0.0.0
#APP_PORT=8080

# Optional: address and port for the MCP server (SSE mode) when running without
# Docker (defaults: 0.0.0.0 and 8081). MCP_PORT must differ from APP_PORT. Use
# MCP_HOST=127.0.0.1 behind a reverse proxy like Caddy. Docker ignores these.
#MCP_HOST=0.0.0.0
#MCP_PORT=8081
